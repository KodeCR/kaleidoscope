load("@monocle//rules:monocle.bzl", "image", "container", "tool")
package(default_visibility = ["//visibility:public"])

image(
	name = "kaleidoscope",
	dockerfile = "kaleidoscope/Dockerfile",
    deps = ["@monocle//containers:monocle",],
)

image(
	name = "riscv-llvm-toolchain",
	dockerfile = "riscv-llvm-toolchain/Dockerfile",
    deps = [":kaleidoscope",],
)

container(
	name = "riscv-toolchain",
	image = ":riscv-llvm-toolchain",
    workdir = "/kaleidoscope",
)

tool(
    name = "clang",
    image = ":riscv-llvm-toolchain",
    workdir = "/kaleidoscope",
    binary = "/opt/kaleidoscope/bin/clang",
)

tool(
    name = "clang++",
    image = ":riscv-llvm-toolchain",
    workdir = "/kaleidoscope",
    binary = "/opt/kaleidoscope/bin/clang++",
)

image(
	name = "riscv-qemu",
	dockerfile = "riscv-qemu/Dockerfile",
    deps = [":kaleidoscope",],
)
